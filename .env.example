#  Copy this file to .env and fill it in.  Never commit .env.
#  Everything except OWNER_NUMBER has a working default.

# ── identity ────────────────────────────────────────────────────────────────
BOT_NAME="WhatsApp Bot"
OWNER_NAME="Your Name"
# Full international format, digits only, no + and no spaces. Comma-separate
# multiple owners. REQUIRED — without it nobody can control the bot.
OWNER_NUMBER=94771234567
# Trusted users who get owner-level command access.
SUDO_NUMBERS=

# ── linking ─────────────────────────────────────────────────────────────────
# Leave both blank to pair by scanning a QR code in the terminal (or at
# http://localhost:8000). Set PAIR_NUMBER to link with an 8-digit code instead.
PAIR_NUMBER=
# A base64-encoded creds.json, for redeploying an existing session.
SESSION_ID=
SESSION_DIR=session

# ── behaviour ───────────────────────────────────────────────────────────────
PREFIX=.
# private = only owner/sudo · public = anyone · group = groups only · inbox = DMs only
MODE=private
TIMEZONE=Asia/Colombo
LANG=en

# ── storage ─────────────────────────────────────────────────────────────────
# Optional. Leave blank to use the built-in SQLite file — no server needed.
# Use YOUR OWN cluster; never a connection string you found in someone's repo.
MONGO_URI=
SQLITE_PATH=data/bot.db

# ── limits ──────────────────────────────────────────────────────────────────
COMMAND_COOLDOWN_MS=2000
RATE_LIMIT_PER_MIN=20
# WhatsApp itself rejects much above 100 MB; leave headroom.
MAX_UPLOAD_MB=90
REQUEST_TIMEOUT_MS=30000
# Refuse audio/video longer than this many minutes.
MAX_DURATION_MIN=20
# Simultaneous downloads. Each one runs yt-dlp + ffmpeg — raise with care.
DOWNLOAD_CONCURRENCY=2

# ── integrations (all optional — a missing key disables one command) ────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# https://openweathermap.org/api
OPENWEATHER_API_KEY=
# https://www.themoviedb.org/settings/api — .movie .tv .trending .cast
TMDB_API_KEY=
# https://www.omdbapi.com/apikey.aspx — .imdb
OMDB_API_KEY=
# https://www.opensubtitles.com/consumers — .sub .subget
OPENSUBTITLES_API_KEY=
# Default subtitle languages, comma separated. si = Sinhala, ta = Tamil.
SUBTITLE_LANGS=en,si

# ── feature flags ───────────────────────────────────────────────────────────
ENABLE_AI=true
ENABLE_MOVIE=true
ENABLE_ADULT=false

# ── web ─────────────────────────────────────────────────────────────────────
PORT=8000
# Public URL of this deployment, used by hosts that sleep idle apps.
PUBLIC_URL=

# ── moderation ──────────────────────────────────────────────────────────────
BLOCKED_NUMBERS=
BLOCKED_GROUPS=

# ── logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Set to debug/trace only when diagnosing connection problems — very noisy.
BAILEYS_LOG=silent

# ── menu ────────────────────────────────────────────────────────────────────
# Banner shown on the main menu. A URL, or a path inside the project.
MENU_IMAGE=assets/banner.png
MENU_TAGLINE=EMBRACE THE NOTHING. BECOME EVERYTHING.
MENU_FOOTER=Void x Hash v.1.0.0
# false is reliable on personal linked accounts; true enables native lists.
INTERACTIVE_MENUS=false
